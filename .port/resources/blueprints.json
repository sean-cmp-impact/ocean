[
    {
        "identifier": "gitguardianSource",
        "title": "GitGuardian Source",
        "icon": "Code",
        "schema": {
            "properties": {
                "id": {
                    "title": "Source ID",
                    "type": "number",
                    "description": "The unique GitGuardian source ID"
                },
                "sourceType": {                    
                    "title": "Source Type",
                    "type": "string",
                    "description": "The GitGuardian source type"
                },
                "fullName": {                    
                    "title": "Source Name",                    
                    "type": "string",
                    "description": "The full name of the GitGuardian source"
                },
                "url": {
                    "title": "Project URL",
                    "type": "string",
                    "format": "url",
                    "description": "URL to the GitGuardian source"
                },
                "health": {
                    "title": "Source Health",
                    "type": "string",
                    "description": "The health of the GitGuardian source",
                    "enum": [
                        "SAFE",
                        "UNKNOWN",
                        "AT_RISK"
                    ],
                    "enumColors": {
                        "SAFE": "green",
                        "UNKNOWN": "yellow",
                        "AT_RISK": "red"
                    }
                },
                "sourceCriticality": {
                    "title": "Source Criticality",
                    "type": "string",
                    "description": "The criticality of the GitGuardian source",
                    "enum": [
                        "CRITICAL",
                        "HIGH",
                        "MEDIUM",
                        "LOW",
                        "UNKNOWN"
                    ],
                    "enumColors": {
                        "LOW": "green",
                        "UNKNOWN": "yellow",
                        "MEDIUM": "orange",
                        "HIGH": "red",
                        "CRITICAL": "red"
                    }
                },
                "openIncidentsCount": {
                    "title": "Open Incident Count",
                    "type": "number",
                    "description": "The total number of open incidents of the GitGuardian source"
                },
                "openIncidentsSeverityBreakdown": {
                    "type": "object",
                    "title": "Open Incidents Severity Breakdown",
                    "properties": {
                        "critical": {
                            "title": "Total Incidents - Critical Severity",
                            "type": "number",
                            "description": "The total number of incidents with critical severity that are still open"
                        },
                        "high": {
                            "title": "Total Incidents - High Severity",
                            "type": "number",
                            "description": "The total number of incidents with high severity that are still open"
                        },
                        "medium": {
                            "title": "Total Incidents - Medium Severity",
                            "type": "number",
                            "description": "The total number of incidents with medium severity that are still open"
                        },
                        "low": {
                            "title": "Total Incidents - Low Severity",
                            "type": "number",
                            "description": "The total number of incidents with low severity that are still open"
                        },
                        "unknown": {
                            "title": "Total Incidents - Unknown Severity",
                            "type": "number",
                            "description": "The total number of incidents with an unknown severity that are still open"
                        }
                    }
                }, 
                "closedIncidentsCount": {
                    "title": "Closed Incident Count",
                    "type": "number",
                    "description": "The total number of closed incidents of the GitGuardian source"
                },
                "closedIncidentsSeverityBreakdown": {
                    "type": "object",
                    "title": "Closed Incidents Severity Breakdown",
                    "properties": {
                        "critical": {
                            "title": "Total Incidents - Critical Severity",
                            "type": "number",
                            "description": "The total number of incidents with critical severity that are closed"
                        },
                        "high": {
                            "title": "Total Incidents - High Severity",
                            "type": "number",
                            "description": "The total number of incidents with high severity that are closed"
                        },
                        "medium": {
                            "title": "Total Incidents - Medium Severity",
                            "type": "number",
                            "description": "The total number of incidents with medium severity that are closed"
                        },
                        "low": {
                            "title": "Total Incidents - Low Severity",
                            "type": "number",
                            "description": "The total number of incidents with low severity that are closed"
                        },
                        "unknown": {
                            "title": "Total Incidents - Unknown Severity",
                            "type": "number",
                            "description": "The total number of incidents with an unknown severity that are closed"
                        }
                    }
                },
                "lastScan": {
                    "type": "object",
                    "title": "Closed Incidents Severity Breakdown",
                    "properties": {
                        "date": {
                            "title": "Last Scan Date",
                            "type": "string",
                            "description": "The date this GitGuardian source was scanned",
                            "format": "date-time"
                        },
                        "status": {                    
                            "title": "Status of Scan",
                            "type": "string",
                            "description": "The status of the last scan "
                        },
                        "failingReason": {                    
                            "title": "Failing Reason",
                            "type": "string",
                            "description": "The reason description of a possible scan failure"
                        },
                        "commitScanned": {
                            "title": "Commits Scanned",
                            "type": "number",
                            "description": "The total number of commits scanned"
                        },
                        "duration": {
                            "title": "Scan Duration",
                            "type": "string",
                            "description": "The total time in seconds that it took to complete the scan"
                        },
                        "branchesScanned": {
                            "title": "Branches Scanned",
                            "type": "number",
                            "description": "The total number of branches scanned"
                        },
                        "progress": {
                            "title": "Scan Progress",
                            "type": "number",
                            "description": "The progress of the scan"
                        }
                    }
                },
                "visibility": {
                    "title": "Source Visibility",
                    "type": "string",
                    "description": "The visibility of the GitGuardian source",
                    "enum": [
                        "PRIVATE",
                        "PUBLIC"
                    ]
                }         
            },
            "required": []
        },
        "relations": {}
    },
    {
        "identifier": "gitguardianSecretDetector",
        "title": "GitGuardian Secret Detector",
        "icon": "ManageSearch",
        "schema": {
            "properties": {
                "name": {
                    "title": "Detector Name",
                    "type": "string",
                    "description": "The name of the Secret Detector"
                },
                "displayName": {
                    "title": "Detector Display Name",
                    "type": "string",
                    "description": "The display name of the Secret Detector"
                },
                "type": {
                    "title": "Detector Type",
                    "type": "string",
                    "description": "The type of Secret Detector",
                    "enum": [
                        "SPECIFIC",
                        "GENERIC",
                        "CUSTOM"
                    ]
                }, 
                "category": {
                    "title": "Detector Category",
                    "type": "string",
                    "description": "The Secret Detector category"
                },       
                "isActive": {
                    "title": "Detector Active",
                    "type": "boolean",
                    "description": "Indicates if the Secret Detector is active or not"
                },
                "scansCodeOnly": {
                    "title": "Scans Code Only",
                    "type": "boolean",
                    "description": "Indicates if the Secret Detector only scans code"
                },
                "checkable": {
                    "title": "Checkable",
                    "type": "boolean",
                    "description": "Indicates if the Secret Detector is checkable"
                },
                "useWithValidityCheckDisabled": {
                    "title": "Use With Validity Check Disabled",
                    "type": "boolean",
                    "description": "Indicates if the Secret Detector can be used with validity check disabled"
                },
                "frequency": {
                    "title": "Detector Frequency",
                    "type": "string",
                    "description": "The Secret Detector frequency"
                }, 
                "removed_at": {
                    "title": "Removed At",
                    "type": "string",
                    "description": "The date and time that the Secret Detector was removed",
                    "format": "date-time"
                },
                "openIncidentsCount": {
                    "title": "Open Incidents Count",
                    "type": "number",
                    "description": "The total number of open incidents for this Secret Detector"
                },
                "ignoredIncidentsCount": {
                    "title": "Ignored Incidents Count",
                    "type": "number",
                    "description": "The total number of ignored incidents for this Secret Detector"
                },
                "resolvedIncidentsCount": {
                    "title": "Resolved Incidents Count",
                    "type": "number",
                    "description": "The total number of resolved incidents for this Secret Detector"
                }
            },
            "required": []
        },
        "relations": {}
    },
    {
        "identifier": "gitguardianSecretIncident",
        "title": "GitGuardian Secret Incident",
        "icon": "Alert",
        "schema": {
            "properties": {
                    "id": {
                        "title": "Incident ID",
                        "type": "number",
                        "description": "The unique internal secret incident ID"
                    },
                    "exposure": {
                        "title": "Secret Exposure",
                        "type": "string",
                        "description": "Indicates the secret's level of exposore",
                        "enum": [
                            "INTERNAL",
                            "PUBLIC"
                        ]
                    },
                    "date": {
                        "title": "Incident Detection Date",
                        "type": "string",
                        "description": "The date and time that the internal secret incident was detected",
                        "format": "date-time"
                    },
                    "detector": {
                        "title": "Secret Detector Details",
                        "type": "object",
                        "properties": {
                            "name": {
                                "title": "Detector Name",
                                "type": "string",
                                "description": "The Secret Detector name"
                            },
                            "display_name": {
                                "title": "Detector Display Name",
                                "type": "string",
                                "description": "The Secret Detector display name"
                            },
                            "nature": {
                                "title": "Detector Type",
                                "type": "string",
                                "description": "The type of Secret Detector",
                                "enum": [
                                    "SPECIFIC",
                                    "GENERIC",
                                    "CUSTOM"
                                ]
                            },
                            "family": {
                                "title": "Detector Family",
                                "type": "string",
                                "description": "The Secret Detector family"
                            },
                            "detectorGroupName": {
                                "title": "Detector Group Name",
                                "type": "string",
                                "description": "The Secret Detector group name"
                            },
                            "detectorGroupDisplayName": {
                                "title": "Detector Group Display Name",
                                "type": "string",
                                "description": "The Secret Detector group display name"
                            }                            
                        }
                    },
                    "secretId": {
                        "title": "Secret ID",
                        "type": "number",
                        "description": "The unique secret ID"
                    },
                    "gitguardianUrl": {
                        "title": "Incident URL",
                        "type": "string",
                        "format": "url",
                        "description": "URL to incident in GitGuardian"
                    },
                    "regression": {
                        "title": "Regression",
                        "type": "boolean",
                        "description": "Indicates if it is a regression"
                    },
                    "status": {
                        "title": "Incident Status",
                        "type": "string",
                        "description": "The status of the internal secret incident",
                        "enum": [
                            "IGNORED",
                            "TRIGGERED",
                            "ASSIGNED",
                            "RESOLVED"
                        ]
                    },
                    "occurrencesCount": {
                        "title": "Incident Occurrences",
                        "type": "number",
                        "description": "The amount of times this specific internal secret incident was detected"
                    },
                    "ignoreReason": {
                        "title": "Ignore Reason",
                        "type": "string",
                        "description": "The reason an internal secret incident was ignored"
                    },
                    "ignoredAt": {
                        "title": "Ignore At",
                        "type": "string",
                        "description": "The date and time that the internal secret incident was ignored",
                        "format": "date-time"
                    },
                    "secretRevoked": {
                        "title": "Secret Revoked",
                        "type": "boolean",
                        "description": "Indicates if the secret has been revoked or not"
                    },
                    "severity": {
                        "title": "Incident Severity",
                        "type": "string",
                        "description": "The severity of the internal secret incident",
                        "enum": [
                            "CRITICAL",
                            "HIGH",
                            "MEDIUM",
                            "LOW",
                            "INFO",
                            "UNKNOWN"
                        ],
                        "enumColors": {
                            "LOW": "green",
                            "UNKNOWN": "yellow",
                            "INFO": "yellow",
                            "MEDIUM": "orange",
                            "HIGH": "red",
                            "CRITICAL": "red"
                        }
                    },
                    "validity": {
                        "title": "Incident Validity",
                        "type": "string",
                        "description": "The validity of the internal secret incident",
                        "enum": [
                            "VALID",
                            "INVALID",
                            "FAILED_TO_CHECK",
                            "NO_CHECKER",
                            "UNKNOWN"
                        ]
                    },
                    "resolved_at": {
                        "title": "Resolved At",
                        "type": "string",
                        "description": "The date and time that the internal secret incident was resolved",
                        "format": "date-time"
                    }
                },
            "required": []
        },
        "relations": {}
    },
    {
        "identifier": "gitguardianTeam",
        "title": "GitGuardian Team",
        "icon": "Team",
        "schema": {
            "properties": {
                    "id": {
                        "title": "Team ID",
                        "type": "number",
                        "description": "The unique GitGuardian team ID"
                    },
                    "name": {
                        "title": "Team Name",
                        "type": "string",
                        "description": "The name of the GitGuardian Team"
                    },
                    "description": {
                        "title": "Team Description",
                        "type": "string",
                        "description": "A description of the GitGuardian Team"
                    },
                    "isGlobal": {
                        "title": "Is Global",
                        "type": "boolean",
                        "description": "Indicates if the team is global or not"
                    },
                    "gitguardianUrl": {
                        "title": "GitGuardian URL",
                        "type": "string",
                        "format": "url",
                        "description": "URL to the team in GitGuardian"
                    }
                },
            "required": []
        },
        "relations": {}
    },
    {
        "identifier": "gitguardianWorkspaceMember",
        "title": "GitGuardian Workspace Member",
        "icon": "User",
        "schema": {
            "properties": {
                    "id": {
                        "title": "Member ID",
                        "type": "number",
                        "description": "The unique GitGuardian workspace member ID"
                    },
                    "name": {
                        "title": "Member Name",
                        "type": "string",
                        "description": "The name of the workspace member"
                    },
                    "email": {
                        "title": "Member Email",
                        "type": "string",
                        "description": "The email address of the workspace member"
                    },
                    "accessLevel": {
                        "title": "Access Level",
                        "type": "string",
                        "description": "The level of access that the workspace member has",
                        "enum": [
                            "OWNER",
                            "MANAGER",
                            "MEMBER",
                            "RESTRICTED"
                        ]
                    },
                    "active": {
                        "title": "Active",
                        "type": "boolean",
                        "description": "Indicates if the member is active or not"
                    },
                    "createdAt": {
                        "title": "Created At",
                        "type": "string",
                        "description": "The date and time the workspace member was created",
                        "format": "date-time"
                    },
                    "lastLogin": {
                        "title": "Last Login",
                        "type": "string",
                        "description": "The date and time the workspace member has last logged into GitGuardian",
                        "format": "date-time"
                    }
                },
            "required": []
        },
        "relations": {}
    },
    {
        "identifier": "gitguardianTeamMember",
        "title": "GitGuardian Team Member",
        "icon": "User",
        "schema": {
            "properties": {
                    "id": {
                        "title": "ID",
                        "type": "number",
                        "description": "The unique membership ID"
                    },
                    "memberId": {
                        "title": "Member ID",
                        "type": "number",
                        "description": "The unique member ID"
                    },
                    "teamId": {
                        "title": "Team ID",
                        "type": "number",
                        "description": "The unique GitGuardian team ID"
                    },
                    "isTeamLeader": {
                        "title": "Is Team Leader",
                        "type": "boolean",
                        "description": "Indicates if the member is a team leader or not"
                    },
                    "incidentPermission": {
                        "title": "Incident Permission",
                        "type": "string",
                        "description": "The incident permissions that the member has in this team",
                        "enum": [
                            "CAN_MANAGE",
                            "CANNOT_MANAGE"
                        ]
                    }
                },
            "required": []
        },
        "relations": {}
    },
    {
        "identifier": "gitguardianDeveloper",
        "title": "GitGuardian Developer",
        "icon": "Rocket",
        "schema": {
            "properties": {
                    "id": {
                        "title": "Developer ID",
                        "type": "number",
                        "description": "The unique GitGuardian Developer ID"
                    },
                    "name": {
                        "title": "Developer Name",
                        "type": "string",
                        "description": "The name of the GitGuardian Developer"
                    },
                    "type": {
                        "title": "Developer Type",
                        "type": "string",
                        "description": "The GitGuardian Developer type"
                    },
                    "emails": {
                        "title": "Emails",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Email addresses of the Developer"
                    },
                    "firstLinkedAt": {
                        "title": "First Linked At",
                        "type": "string",
                        "description": "The date and time the GitGuardian Developer was first linked",
                        "format": "date-time"
                    },
                    "isActive": {
                        "title": "Is Active",
                        "type": "boolean",
                        "description": "Indicates if the developer is active or not"
                    },
                    "githubId": {
                        "title": "GitHub ID",
                        "type": "number",
                        "description": "The Developer's GitHub ID"
                    },
                    "githubLogin": {
                        "title": "GitHub Login",
                        "type": "string",
                        "description": "The Developer's GitHub Login"
                    }
                },
            "required": []
        },
        "relations": {}
    }
]
