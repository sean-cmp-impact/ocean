    {
        "identifier": "gitguardianUser",
        "title": "GitGuardian User",
        "icon": "User",
        "schema": {
            "properties": {
                    "name": {
                        "title": "User Name",
                        "type": "string",
                        "description": "The name of the user/workspace member"
                    },
                    "email": {
                        "title": "User Email",
                        "type": "string",
                        "description": "The email address of the user/workspace member"
                    },
                    "accessLevel": {
                        "title": "Access Level",
                        "type": "string",
                        "description": "The level of access that the user/workspace member has",
                        "enum": [
                            "owner",
                            "manager",
                            "member",
                            "restricted"
                        ]
                    },
                    "active": {
                        "title": "Active",
                        "type": "boolean",
                        "description": "Indicates if the member is active or not"
                    },
                    "createdAt": {
                        "title": "Created At",
                        "type": "string",
                        "description": "The date and time the user/workspace member was created",
                        "format": "date-time"
                    },
                    "lastLogin": {
                        "title": "Last Login",
                        "type": "string",
                        "description": "The date and time the user/workspace member has last logged into GitGuardian",
                        "format": "date-time"
                    }
                },
            "required": []
        },
        "relations": {}
    }
